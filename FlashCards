# modules and starting items
import math
from random import randint
from roman import Romanize 
from fractions import Fraction
square_dictionary = {}
square_root_dictionary = {}
square_root_list = [2, 3, 5, 6, 7, 8]
roman_numeral_dictionary = {}
decimal_dictionary = {}

# making perfect square dictionary
for number in range (1,30):
    square_dictionary[number]= number**2

# making square root dictionary
for number in square_root_list:
    square_root_dictionary[number] = round(math.sqrt(number),2)

# making roman numeral dictionary
for number in range (1, 1000, 7):
    numeral = Romanize(number)
    roman_numeral_dictionary[number] = numeral
    roman_numeral_dictionary[numeral] = number

# making decimal dictionary
for number in range (2, 17):
    decimal_dictionary[f"1/{number}"] = round(1/number, 4)

# this asks the questions and collects the score
def quizzer(dictionary, function, message):
    is_done = False
    length_usable = False
    score = 0
    

    while is_done == False:
        # asks them how many questions they want in their quiz
        quiz_length = input("Welcome to randomized quiz review!\
                            \nTo better help you with memorization, if you get a question wrong it will tell you what the answer was supposed to be.\
                            \nPlease type the number of questions you'd like in your quiz (1 to 100).\n\n")
        while length_usable == False:
            if (quiz_length == "" or quiz_length.isnumeric() == False) and (0 < int(quiz_length) < 100 == False):
                print("You must type a number between 1 and 100")
            else:
                quiz_length = int(quiz_length)
                length_usable = True
                break
        
        print(message) # additional instructions based on quiz
        print("The quiz will now begin! If you'd like to end early type 'done'.\n")
        
        # loop that generates the question (from dictionary values) and checks the answer
        for questions in range (0, quiz_length):
            index = randint(1,len(list(dictionary))-1)
            user_answer = input(f"What is {list(dictionary)[index]} {function}? \n")

            if user_answer == str(dictionary[list(dictionary)[index]]) or user_answer == str(dictionary[list(dictionary)[index]]).strip("0"):
                print("Correct :)\n")
                score += 1
            elif user_answer.lower() == "done":
                is_done = True
                ending_sequence(score, questions)
                return None
            else:
                print(f"The answer was {dictionary[list(dictionary)[index]]}\n")
        ending_sequence(score, quiz_length)
        return None

# allows them to choose if they want to view a list, do flashcards, or quiz themselves
def review_method(function):
    input_usable = False
    review_type = input(f"If you'd like to review the list of {function} type 'list.'\n\
If you'd like review flashcards type 'flashcards.'\n\
If you'd like to quiz yourself type 'quiz.'\n\
Type 'done' to exit.\n\n")

    while input_usable == False:
        if review_type.lower() == "list":
            input_usable = True
            return review_type
        elif review_type.lower() == "flashcards":
            input_usable = True
            return review_type
        elif review_type.lower() == "quiz":
            input_usable = True
            return review_type
        elif review_type.lower() == "done":
            input_usable = True
            return None
        else:
            review_type = input("You must type 'list', 'flashcards', 'quiz', or 'done'\n\n")

# Says goodbye and score (if applicable)
def ending_sequence(score, questions):
    if questions > 0:
        print (f"You got {score} out of {questions} questions correct!")
    print("Have a nice day!")

# allows them to choose a topic, then review method
def main():
    print("Welcome to the Memorization Station of Math Mania!")
    choice = input("Please select whether you'd like to review 'squares', 'square roots', 'roman numerals', 'decimals' or type 'done' to exit. \n\n")
    while True:
        if choice.lower() == "squares":
            method = review_method("perfect squares")
            if method == "list":
                print(square_dictionary)
                ending_sequence(0,0)
                return None
            elif method == "flashcards":
                print("Sorry, this is a UI only feature.")
                ending_sequence(0,0)
                return None
            elif method == "quiz":
                quizzer (square_dictionary, "squared", None)
                return None
            else:
                print("Have a nice day!")
                return None

        elif choice.lower() == "square roots":
            method = review_method("common square roots")
            if method == "list":
                print(square_dictionary)
                ending_sequence(0,0)
                return None
            elif method == "flashcards":
                print("Sorry, this is a UI only feature.")
                ending_sequence(0,0)
                return None
            elif method == "quiz":
                quizzer (square_root_dictionary, "square rooted", "Please round your answer to the hundreths place.")
                return None
            else:
                print("Have a nice day!")
                return None
        elif choice.lower() == "roman numerals":
            method = review_method("a lot of roman numerals")
            if method == "list":
                print(square_dictionary)
                ending_sequence(0,0)
                return None
            elif method == "flashcards":
                print("Sorry, this is a UI only feature.")
                ending_sequence(0,0)
                return None
            elif method == "quiz":
                quizzer (roman_numeral_dictionary, "in the other form", "If you are given a roman numeral, convert it to a number.\
                         \nIf you are given a number, convert it to a roman numeral. \nYou must type roman numerals in ALL CAPS.")
                return None
            else:
                ending_sequence(0,0)
                return None
        elif choice.lower() == "decimals":
            method = review_method("common fractions as decimals")
            if method == "list":
                print(decimal_dictionary)
                ending_sequence(0,0)
                return None
            elif method == "flashcards":
                print("Sorry, this is a UI only feature.")
                ending_sequence(0,0)
                return None
            elif method == "quiz":
                quizzer (decimal_dictionary, "as a decimal", "If needed, round to 4 decimal places.")
                return None
            else:
                print("Have a nice day!")
                return None
        elif choice.lower() == "done":
            ending_sequence(0,0)
            return None
        else:
            choice = input("You must type 'squares', 'square roots', 'roman numerals', or 'done'\n\n")
        
main()

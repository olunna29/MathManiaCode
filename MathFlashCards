# this asks the questions and collects the score
def quizzer(dictionary, function, message):
    is_done = False
    length_usable = False
    score = 0
    

    while is_done == False:
        # asks them how many questions they want in their quiz
        quiz_length = input("Welcome to randomized quiz review!\
                            \nTo better help you with memorization, if you get a question wrong it will tell you what the answer was supposed to be.\
                            \nPlease type the number of questions you'd like in your quiz (1 to 100).\n\n")
        while length_usable == False:
            if (quiz_length == "" or quiz_length.isnumeric() == False) and (0 < int(quiz_length) < 100 == False):
                print("You must type a number between 1 and 100")
            else:
                quiz_length = int(quiz_length)
                length_usable = True
                break
        
        print(message) # additional instructions based on quiz
        print("The quiz will now begin! If you'd like to end early type 'done'.\n")
        
        # loop that generates the question (from dictionary values) and checks the answer
        for questions in range (0, quiz_length):
            index = randint(1,len(list(dictionary))-1)
            user_answer = input(f"What is {list(dictionary)[index]} {function}? \n")

            if user_answer == str(dictionary[list(dictionary)[index]]) or user_answer == str(dictionary[list(dictionary)[index]]).strip("0"):
                print("Correct :)\n")
                score += 1
            elif user_answer.lower() == "done":
                is_done = True
                ending_sequence(score, questions)
                return None
            else:
                print(f"The answer was {dictionary[list(dictionary)[index]]}\n")
        ending_sequence(score, quiz_length)
        return None

# allows them to choose if they want to view a list, do flashcards, or quiz themselves
def review_method(function):
    input_usable = False
    review_type = input(f"If you'd like to review the list of {function} type 'list.'\n\
If you'd like review flashcards type 'flashcards.'\n\
If you'd like to quiz yourself type 'quiz.'\n\
Type 'done' to exit.\n\n")

    while input_usable == False:
        if review_type.lower() == "list":
            input_usable = True
            return review_type
        elif review_type.lower() == "flashcards":
            input_usable = True
            return review_type
        elif review_type.lower() == "quiz":
            input_usable = True
            return review_type
        elif review_type.lower() == "done":
            input_usable = True
            return None
        else:
            review_type = input("You must type 'list', 'flashcards', 'quiz', or 'done'\n\n")

def ending_sequence(correct, total):    
    if total > 0:
        print(f"You got {correct} out of {total} questions correct!\n")



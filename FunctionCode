def squares():   
    score = 0  

    # generating numbers, setting answer, and requesting input for squares
    number = randint(1,199)
    real_answer = number * number
    user_answer = input(f"What is {number} squared?\n")
        
    if user_answer.lower() == "done":
        answering_questions = False
        is_done = True
        return None
        
    score += answer_checking(user_answer, real_answer)
    return score
def multi(number_of_functions, new_list_of_functions):
    score = 0  
    function_dictionary = {"2 by 2 Addition" : addition("2,2"), "3 by 3 Addition" : addition("3,3"), "2 by 2 Subtraction" : subtraction("2,2"), 
                           "3 by 3 Subtraction" : subtraction("3,3"), "2 by 2 Multiplication" : multiplication("2,2"), 
                           "3 by 3 Multiplication" : multiplication("3,3"), "Division" : division(), "Square" : squares()}

    
    while is_done == False:
        question_type = randint (0, number_of_functions-1)
        current_function = new_list_of_functions[question_type]
        
        counter = function_dictionary[current_function]
        
        if counter == None:
            is_done = True
            return None

        score += counter
    return score

# says goodbye and prints score
def ending_sequence(correct, total):    
    # closing statement with score
    if total > 0:
        print(f"You got {correct} out of {total} questions correct!\
        \nHave a nice day!")
    else:
        print("Have a nice day!")

# checks if user wants to say done (before they get to the question portion)
def done_checker(value):
    if value == None:
        return True
    else:
        return False

# runs the program
def main():
    questions_answered = 0
    score = 0
    is_done = False
    
    while is_done == False:
        chosen_function = function_chooser()
        if done_checker(chosen_function) == True:
            ending_sequence(0,0)
            is_done = True
            break
        elif chosen_function == "+" or chosen_function == "-" or chosen_function == "*":
            chosen_digits = digit_requester()
            if done_checker(chosen_digits) == True:
                ending_sequence(0,0)
                is_done = True
                break
            score, questions_answered = question_looper(chosen_function, chosen_digits, None)
            ending_sequence(score, questions_answered)
            is_done = True
            break   
        elif chosen_function == "/" or chosen_function == "square":
            score, questions_answered = question_looper(chosen_function, None, None)
            ending_sequence(score, questions_answered)
            is_done = True
            break   
        elif chosen_function == "multi":
            list_of_functions = multi_function_chooser()
            score, questions_answered = question_looper(chosen_function, None, list_of_functions)
            ending_sequence(score, questions_answered)
            is_done = True
            break   
    


main()
